{
  "name": "@bgo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pglite": "./src/pglite-server.ts",
    "./client": "./src/client.ts",
    "./store": "./src/store.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "build": "tsc --noEmit",
    "pglite:up": "tsx src/pglite-cli.ts up",
    "pglite:down": "tsx src/pglite-cli.ts down"
  },
  "dependencies": {
    "@bgo/commercial": "workspace:*",
    "@bgo/contracts": "workspace:*",
    "@bgo/observability": "workspace:*",
    "@electric-sql/pglite": "0.3.7",
    "@electric-sql/pglite-socket": "0.0.12",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2"
  }
}
