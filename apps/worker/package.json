{
  "name": "@bgo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external"
  },
  "dependencies": {
    "@bgo/commercial": "workspace:*",
    "@bgo/contracts": "workspace:*",
    "@bgo/db": "workspace:*",
    "@bgo/observability": "workspace:*",
    "bullmq": "5.58.0",
    "ioredis": "5.6.1",
    "redis-memory-server": "0.17.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
