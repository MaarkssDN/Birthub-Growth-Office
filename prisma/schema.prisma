// Birthub Growth Office — schema Prisma (Ondas 00-11)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // postgresql://bgo_user:***@127.0.0.1:5437/birthub_growth_office_dev
}

model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique // 'birthub-growth'
  name      String
  ownerId   String
  status    String   @default("active") // active | suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  leads     Lead[]
  missions  Mission[]
  events    EventOutbox[]
  audits    AuditEvent[]
}

model User {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  email        String   @unique
  name         String
  passwordHash String
  roleId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AuthSession[]
}

model OfferClaim {
  id          String   @id @default(cuid())
  workspaceId String
  claim       String
  evidenceUrl String?
  status      String   // approved | pending | rejected
  version     String   // ex.: offer-v1
  approvedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ICPProfile {
  id           String    @id @default(cuid())
  workspaceId  String
  revision     String    // icp-hypothesis-v1
  segments     Json
  pains        Json
  excludes     Json
  scoreRubric  Json
  validatedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  source      String   // demo_form | indication | content | synthetic
  sourceUrl   String?
  capturedAt  DateTime @default(now())
  status      String   @default("new")
  name        String?
  email       String?
  phone       String?
  company     String?
  interest    String?
  synthetic   Boolean  @default(false)
  dedupKey    String?
  provenance  Json     // {source, at, legalBasis}
  consent     Json?    // {channel, optIn, at}
  privacy     Json?    // {noticeVersion, acceptedAt, channels, marketingOptIn}
  suppressedAt DateTime?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  opportunities Opportunity[]
  missions    Mission[]

  @@index([dedupKey])
  @@index([email])
  @@index([status])
}

model ChannelPermission {
  id            String  @id @default(cuid())
  workspaceId   String
  channel       String  // email | whatsapp | phone
  optInRequired Boolean @default(true)
  templatesRequired Boolean @default(false)
  allowed       Boolean @default(false) // W00: false p/ externos
}

model Opportunity {
  id             String   @id @default(cuid())
  workspaceId    String
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id])
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  missionId      String?
  stage          String   @default("approved_target")
  priority       String   @default("normal")
  icpScore       Int      @default(0)
  currentAgentId String?
  nextAction     String?
  justification  String   @default("")
  source         String   @default("scout")
  approvedBy     String   @default("system")
  approvedAt     DateTime @default(now())
  correlationId  String   @default("")
  lostReason     String?
  lastActivityAt DateTime @default(now())
  ownerId        String?
  amount         Decimal? // sempre null na W00-W11
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  history        OpportunityHistory[]

  @@unique([workspaceId, companyId])
  @@index([workspaceId, stage])
  @@index([workspaceId, currentAgentId])
}

model OpportunityHistory {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  fromStage     String?
  toStage       String?
  action        String
  actor         String
  reason        String?
  details       Json?
  correlationId String
  occurredAt    DateTime    @default(now())

  @@index([opportunityId, occurredAt])
}

model Mission {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id])
  companyId     String?
  opportunityId String?
  requester     String
  goal          String
  status        String   @default("draft")
  correlationId String   @unique
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tasks         Task[]
  runs          ExecutionRun[]
  approvals     ApprovalRequest[]
}

model Task {
  id           String   @id @default(cuid())
  workspaceId  String
  missionId    String
  mission      Mission  @relation(fields: [missionId], references: [id])
  assigneeId   String   // agentId ou userId
  title        String
  status       String   @default("pending") // pending|assigned|done|blocked
  dueAt        DateTime?
  dependsOn    String[]
  correlationId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AgentDefinition {
  id              String  @id // agentId canônico (aegis, relay, ...)
  personaId       String? // CharacterPersona.id quando houver visual
  capabilities    Json
  autonomyCeiling String  // L0..L4
  active          Boolean @default(false)
  createdAt       DateTime @default(now())
}

model AgentAssignment {
  id          String   @id @default(cuid())
  workspaceId String
  missionId   String
  agentId     String
  role        String
  assignedBy  String
  assignedAt  DateTime @default(now())
}

model ExecutionRun {
  id            String   @id @default(cuid())
  workspaceId   String
  missionId     String
  mission       Mission  @relation(fields: [missionId], references: [id])
  agentId       String
  provider      String   @default("mock")
  mock          Boolean  @default(true)
  status        String   @default("queued")
  costUnits     Int      @default(0)
  durationMs    Int      @default(0)
  input         Json?
  output        Json?
  correlationId String
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  steps         ExecutionStep[]
}

model ExecutionStep {
  id         String   @id @default(cuid())
  runId      String
  run        ExecutionRun @relation(fields: [runId], references: [id])
  seq        Int
  tool       String
  action     String
  inputRef   String?
  outputRef  String?
  decision   Json?
  createdAt  DateTime @default(now())
}

model ApprovalRequest {
  id           String   @id @default(cuid())
  workspaceId  String
  missionId    String
  mission      Mission  @relation(fields: [missionId], references: [id])
  action       String   // ex.: draft.review, channel.send
  scope        String
  reason       String
  preview      Json
  requestedBy  String   // agentId ou userId
  approverRole String   // owner|approver
  status       String   @default("pending") // pending|approved|rejected|expired
  decision     String?
  decidedBy    String?
  decidedAt    DateTime?
  decidedReason String?
  expiresAt    DateTime?
  correlationId String
  createdAt    DateTime @default(now())
}

model CommercialDraft {
  id              String   @id @default(cuid())
  workspaceId     String
  missionId       String?
  companyId       String?
  opportunityId   String?
  channel         String   // email|whatsapp|internal_note
  recipientPolicy String   // synthetic_only | opt_in_required | blocked
  template        String?
  claimRefs       String[]
  text            String
  status          String   @default("draft") // draft|approved|rejected|sent_blocked
  simulated       Boolean  @default(true)
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EventOutbox {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  eventId       String    @unique
  eventType     String
  version       Int
  correlationId String
  missionId     String?
  agentId       String?
  occurredAt    DateTime
  payload       Json
  publishedAt   DateTime?
}

model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // sha256 do token opaco — token nunca persistido em claro
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  workspaceId String
  role       String   // owner|operator|approver|auditor (snapshot)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  actor          String
  action         String
  entity         String
  entityId       String
  occurredAt     DateTime @default(now())
  correlationId  String
  redactedPayload Json?
  outcome        String   // allowed|denied|info
  createdAt      DateTime @default(now())
}

// ---------- Onda 10: Central Scout + Custos de IA ----------

model ImportBatch {
  id            String    @id @default(cuid())
  workspaceId   String
  fonte         String    // origem declarada pelo operador (obrigatória)
  filename      String?
  missionId     String?
  correlationId String
  totalRows     Int       @default(0)
  imported      Int       @default(0)
  duplicates    Int       @default(0)
  rejected      Int       @default(0)
  rejectedDetail Json?
  importedBy    String
  createdAt     DateTime  @default(now())
  companies     Company[]

  @@index([workspaceId, createdAt])
}

model Company {
  id            String   @id @default(cuid())
  workspaceId   String
  batchId       String?
  batch         ImportBatch? @relation(fields: [batchId], references: [id])
  cnpj          String   // 14 dígitos normalizados
  razaoSocial   String
  nomeFantasia  String?
  cnae          String?
  porte         String?
  situacao      String?
  municipio     String?
  uf            String?
  fonte         String
  importadoEm   DateTime
  score         Int      @default(0)      // 0-100, heurística ICP — não é diagnóstico de IA
  scoreVersion  String   @default("score-icp-v1")
  reasons       Json     @default("[]")
  gaps          Json     @default("[]")
  reviewStatus  String   @default("pending") // pending|approved|rejected|archived
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewReason  String?
  missionId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  history       CompanyHistory[]
  opportunities Opportunity[]

  @@unique([workspaceId, cnpj])
  @@index([workspaceId, reviewStatus])
  @@index([workspaceId, uf])
}

model CompanyHistory {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  action     String   // imported|review_approved|review_rejected|review_archived|reimport_seen|opportunity_created
  actor      String
  reason     String?
  details    Json?
  occurredAt DateTime @default(now())

  @@index([companyId, occurredAt])
}

model AiTariff {
  id               String   @id @default(cuid())
  version          String   // ex.: tariff-v1
  provider         String
  model            String
  currency         String   @default("USD")
  inputPer1MTokens Decimal
  outputPer1MTokens Decimal
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([version, provider, model])
}

model AiUsageRecord {
  id             String   @id @default(cuid())
  workspaceId    String
  missionId      String?
  agentId        String
  provider       String
  model          String
  promptKey      String?
  promptVersion  String?
  simulated      Boolean  @default(false)
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costUnits      Int      @default(0)
  estimatedCost  Decimal? // null quando não há tarifa ativa — nunca apresentar como faturado
  billedCost     Decimal? // somente quando informado pelo provedor
  tariffVersion  String?
  durationMs     Int      @default(0)
  status         String   // success|failure|blocked
  error          String?
  correlationId  String?
  occurredAt     DateTime @default(now())

  @@index([workspaceId, occurredAt])
  @@index([missionId])
  @@index([agentId])
}
