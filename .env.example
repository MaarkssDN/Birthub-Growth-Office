# Birthub Growth Office — variáveis de ambiente (SOMENTE placeholders, sem segredos)

# --- API (apps/api) ---
BGO_API_PORT=4181
BGO_API_HOST=127.0.0.1
BGO_MODE=mock            # mock | real (real bloqueado na Onda 00)
BGO_WORKSPACE_SLUG=birthub-growth

# --- Web (apps/web) ---
BGO_WEB_PORT=4180
VITE_API_URL=http://127.0.0.1:4181

# --- Persistência (futuro; inativo enquanto BGO_MODE=mock) ---
# DATABASE_URL=postgresql://bgo_user:CHANGE_ME@127.0.0.1:5437/birthub_growth_office_dev
# REDIS_URL=redis://127.0.0.1:6387

# --- Auth local de desenvolvimento (trocar em qualquer ambiente compartilhado) ---
BGO_SEED_OWNER_EMAIL=owner@bgo.local
BGO_SEED_OWNER_PASSWORD=trocar-esta-senha
BGO_SESSION_SECRET=trocar-por-aleatorio-longo

# --- IA (Onda 00: MockProvider apenas; nenhum custo) ---
# BGO_AI_PROVIDER=mock
# BGO_AI_MONTHLY_BUDGET=0

# ---- Onda 01 ----
# Senha do admin inicial (owner@bgo.local / approver@bgo.local). Se ausente,
# uma senha aleatória é gerada e impressa UMA vez no console do servidor.
BGO_ADMIN_PASSWORD=
# Habilita APENAS em desenvolvimento local: headers x-bgo-user/x-bgo-role.
# Nunca definir em produção.
BGO_DEV_AUTH=0
# "memory" força store volátil. Qualquer outro valor tenta PostgreSQL/PGlite.
BGO_PERSISTENCE=postgres
# Opcional: DATABASE_URL externa (ex.: postgres real). Default: PGlite embutido
# em 127.0.0.1:5437 com dados em ./var/pglite.
# DATABASE_URL=postgresql://bgo_user:CHANGE_ME@127.0.0.1:5437/birthub_growth_office_dev?sslmode=disable&connection_limit=1

# ---- Onda 02: provedores de IA (desligado por padrão) ----
# Modo real exige AS TRÊS: BGO_AI_MODE=real + BGO_AI_ENABLED=1 + BGO_AI_API_KEY.
# Sem elas, todo o sistema opera em modo SIMULADO (mock determinístico).
BGO_AI_MODE=simulated
BGO_AI_ENABLED=0
BGO_AI_API_KEY=
BGO_AI_BASE_URL=https://api.openai.com/v1
BGO_AI_MODEL=gpt-4o-mini

# ---- Onda 02: fila persistente BullMQ ----
# Sem BGO_REDIS_URL e sem BGO_REDIS_EMBEDDED=1 o worker usa LocalQueue (memória).
# BGO_REDIS_URL=redis://127.0.0.1:6387  (recomendado: Redis real com AOF/RDB)
# BGO_REDIS_EMBEDDED=1                (dev: redis-memory-server em 127.0.0.1:6387, dados voláteis)
