{
  "name": "@bgo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external"
  },
  "dependencies": {
    "@bgo/agents": "workspace:*",
    "@bgo/commercial": "workspace:*",
    "@bgo/contracts": "workspace:*",
    "@bgo/db": "workspace:*",
    "@bgo/observability": "workspace:*",
    "@bgo/ui": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.2.0",
    "zod": "^3.24.1",
    "@bgo/ai": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
